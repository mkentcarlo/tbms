{
  "app_name": "TBMS",
  "app_version": "1.0",
  "window": {
    "title": "TBMS - Treasury Budget Management System",
    "width": 1280,
    "height": 800,
    "min_width": 1024,
    "min_height": 600,
    "start_maximized": false,
    "always_on_top": false,
    "resizable": true,
    "fullscreen": false,
    "icon": "icon.ico"
  },
  "url": "http://127.0.0.1:8000",
  "startup_script": "",
  "chromium": {
    "cache_path": "cache",
    "disk_cache_size": 0,
    "media_cache_size": 0,
    "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    "disable_web_security": false,
    "disable_images": false,
    "disable_javascript": false,
    "disable_plugins": false,
    "disable_smooth_scrolling": false,
    "allow_file_access_from_files": true,
    "allow_running_insecure_content": false,
    "enable_plugins": true,
    "enable_webgl": true,
    "enable_remote_fonts": true,
    "enable_desktop_notifications": false,
    "enable_spell_checking": false,
    "spell_check_dicts": [],
    "enable_media_stream": false,
    "enable_smooth_scrolling": true,
    "enable_tab_to_browser": false,
    "enable_devtools": false,
    "enable_menu": false,
    "enable_default_context_menu": true,
    "enable_drag_drop": true,
    "enable_drag_drop_file_uploads": true,
    "enable_npapi": false,
    "enable_widevine": false,
    "enable_pepper_flash": false,
    "background_color": "#ffffff",
    "accept_language": "en-US,en;q=0.9",
    "disable_background_networking": false,
    "disable_background_timer_throttling": false,
    "disable_client_side_phishing_detection": false,
    "disable_component_updates": false,
    "disable_default_apps": false,
    "disable_extensions": false,
    "disable_hang_monitor": false,
    "disable_prompt_on_repost": false,
    "disable_sync": true,
    "disable_translate": true,
    "metrics_recording_only": false,
    "no_pings": true,
    "safebrowsing_disable_download_protection": false,
    "safebrowsing_disable_auto_update": false,
    "password_store": "basic",
    "proxy_server": "",
    "proxy_pac_url": "",
    "remote_debugging_port": 0
  },
  "php": {
    "php_version": "8.2",
    "exe_path": "php/php.exe",
    "extensions_path": "php/ext",
    "php_ini_path": "php/php.ini",
    "server_software": "PHP Desktop",
    "server_name": "localhost",
    "server_port": 8000,
    "document_root": "www",
    "index_files": ["index.php", "index.html"],
    "cgi_path": "php/php-cgi.exe",
    "cgi_temp_dir": "cache/cgi",
    "enable_cgi": false,
    "enable_fastcgi": false,
    "fastcgi_host": "127.0.0.1",
    "fastcgi_port": 9000,
    "enable_php_errors": true,
    "display_errors": true,
    "error_reporting": "E_ALL & ~E_DEPRECATED & ~E_STRICT",
    "log_errors": true,
    "error_log": "cache/php_errors.log",
    "max_execution_time": 30,
    "max_input_time": 60,
    "memory_limit": "256M",
    "post_max_size": "8M",
    "upload_max_filesize": "2M",
    "date_timezone": "UTC",
    "session_save_path": "cache/sessions",
    "session_name": "PHPSESSID",
    "session_cookie_lifetime": 0,
    "session_cookie_path": "/",
    "session_cookie_domain": "",
    "session_cookie_secure": false,
    "session_cookie_httponly": true,
    "auto_prepend_file": "",
    "auto_append_file": ""
  },
  "v8": {
    "snapshot_blob_path": "",
    "natives_blob_path": "",
    "icu_data_file_path": ""
  },
  "misc": {
    "open_devtools": false,
    "log_file": "cache/debug.log",
    "log_level": "INFO",
    "msi": {
      "install_path": "",
      "install_path_var": "APPDATA"
    },
    "start_minimized": false,
    "close_button_closes_app": true,
    "tray_icon": "icon.ico",
    "tray_icon_tooltip": "TBMS",
    "tray_left_click": "show_window",
    "tray_right_click": "show_menu",
    "tray_menu": [
      {
        "label": "Show Window",
        "action": "show_window"
      },
      {
        "label": "Hide Window",
        "action": "hide_window"
      },
      {
        "label": "-"
      },
      {
        "label": "Exit",
        "action": "exit_app"
      }
    ],
    "startup_script": "",
    "shutdown_script": ""
  }
}
