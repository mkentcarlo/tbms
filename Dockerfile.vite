# Vite dev server Dockerfile
FROM node:20-alpine

WORKDIR /var/www

# Install dependencies
RUN apk add --no-cache git

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm install

# Copy application files
COPY . .

# Expose Vite port
EXPOSE 5173

CMD ["npm", "run", "dev"]

